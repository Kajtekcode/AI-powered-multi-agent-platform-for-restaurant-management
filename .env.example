# ============================================================================
# Restaurant Growth OS — konfiguracja środowiska
# Skopiuj do .env i uzupełnij. NIGDY nie commituj .env.
# ============================================================================

# ── Baza danych ─────────────────────────────────────────────────────────────
# Postgres (Neon) na produkcji. Pominięte → SQLite (sqlite:///data/dev.db) do testów lokalnych.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── Bezpieczeństwo (WYMAGANE) ───────────────────────────────────────────────
# Sekret do podpisywania sesji JWT. Wygeneruj: openssl rand -hex 32
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag

# Klucz szyfrowania kluczy GoPOS (Fernet). Wygeneruj RAZ i nie zmieniaj po zapisaniu danych:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# True za HTTPS (produkcja); lokalnie zostaw false.
COOKIE_SECURE=false

# Długość ważności sesji (godziny). Domyślnie 720 (30 dni).
# JWT_EXPIRE_HOURS=720

# ── LLM (agenci AI) ─────────────────────────────────────────────────────────
# OpenAI:
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
#
# albo xAI / Grok (odkomentuj i użyj zamiast powyższych):
# OPENAI_API_KEY=xai-...
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-3-latest
# Model wizyjny do importu menu ze zdjęcia (Grok nie przyjmuje obrazów w modelu tekstowym):
# OPENAI_VISION_MODEL=grok-2-vision-1212

# ── GoPOS ───────────────────────────────────────────────────────────────────
# UWAGA: w wersji multi-tenant klucze GoPOS podaje się per-restauracja w onboardingu
# (są szyfrowane i zapisywane w bazie). Poniższe pola są opcjonalne — używane tylko
# przez narzędzia CLI/diagnostyczne dla pojedynczej restauracji.
# GOPOS_CLIENT_ID=
# GOPOS_CLIENT_SECRET=
# GOPOS_ORGANIZATION_ID=
GOPOS_BASE_URL=https://app.gopos.io
GOPOS_READ_ONLY=true                # ZAWSZE true — nigdy nie zapisujemy do kasy

# ── Aplikacja ───────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production
APP_PORT=8000
APP_HOST=0.0.0.0

# ── Synchronizacja ──────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=15            # auto-sync co N minut (scheduler włączony domyślnie)
# DISABLE_SCHEDULER=true            # wyłącza scheduler (np. w testach)

# ── Research / wyszukiwarka (Analiza rynku) ─────────────────────────────────
# Domyślnie DuckDuckGo (darmowe, bez klucza). Dla lepszej jakości ustaw provider + klucz:
#   SEARCH_PROVIDER=brave|serper|tavily
#   SEARCH_API_KEY=...
SEARCH_PROVIDER=duckduckgo
# SEARCH_API_KEY=

# ── Powiadomienia / poranny briefing (opcjonalne) ──────────────────────────
# Telegram: @BotFather → /newbot → token. Chat ID: napisz do bota, potem
#   https://api.telegram.org/bot<TOKEN>/getUpdates → "chat":{"id":...}
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789
# SLACK_WEBHOOK_URL=https://hooks.slack.com/...
# BRIEFING_HOUR=8                   # godzina briefingu (czas serwera)
